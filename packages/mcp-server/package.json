{
  "name": "spotify-dj-mcp-server",
  "version": "1.0.0",
  "description": "MCP server que lê playlists do Spotify, monta sets com lógica de DJ (BPM, Camelot, curva de energia) e cria a playlist [DJ MIX] sem tocar na original.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "spotify-dj-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "auth": "node dist/auth-cli.js",
    "dev": "tsx src/index.ts",
    "test:engine": "node dist/tests/engine.test.js",
    "test:server": "node dist/tests/server.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
