{
  "name": "@playme/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor local do Play.Me: Claude Agent SDK + MCP spotify-dj, SSE para o chat, SQLite e gate de aprovação.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --no-warnings dist/main.js",
    "test:repo": "node --no-warnings dist/tests/repo.test.js",
    "test:agent": "node --no-warnings dist/tests/agent.test.js",
    "test:http": "node --no-warnings dist/tests/server.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "spotify-dj-mcp-server": "1.0.0"
  }
}
